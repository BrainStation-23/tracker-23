{
  "cSpell.words": [
    "amcharts",
    "antd",
    "worklog",
    "worklogs"
  ],
  "cSpell.ignoreWords": [
    "DDTHH",
    "SSSZ",
    "anjarul",
    "belal",
    "dipankar",
    "diptonil",
    "hasan",
    "hosen",
    "hossain",
    "officedocument",
    "openxmlformats",
    "rakib",
    "rezve",
    "shaishab",
    "spreadsheetml",
    "svgr",
    "timeoriginalestimate",
    "zeeshan"
  ],
  "task.allowAutomaticTasks": true,
  "debug.openDebug": "neverOpen",
  "terminal.integrated.inheritEnv": false,
  "tasks": {
    "label": "lint on open",
    "type": "shell",
    "command": "npm run lint",
    "runOn": "folderOpen"
  }
}
